{
  "name": "dsh-peak",
  "version": "0.2.1",
  "description": "Peak / off-peak billing badge for the DeepSeek API. Sits in the DSH composer and works out the rate from your own clock.",
  "license": "MIT",
  "author": "tuoLuoSuan",
  "icon": "./icon.svg",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "pricing",
    "off-peak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoLuoSuan/dsh-peak.git"
  },
  "homepage": "https://github.com/tuoLuoSuan/dsh-peak#readme",
  "bugs": {
    "url": "https://github.com/tuoLuoSuan/dsh-peak/issues"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "verify-policy.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node verify-policy.mjs",
    "prepublishOnly": "node docs/audit-publish.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
